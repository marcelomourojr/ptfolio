# @cloudflare/next-on-pages@1.13.16 declara suporte a next <=15.5.2 e este
# projeto está no 16.x; ele também puxa um wrangler cujo peer de
# @cloudflare/workers-types (v5) conflita com o que o próprio adaptador pede (v4).
# Sem isto, o build da Cloudflare morre em ERESOLVE antes de compilar.
legacy-peer-deps=true
